# ============================================================
# LifeConnect API — Environment Variables Example
# Copy to .env and replace all CHANGE_ME values with real ones.
# This file is SAFE TO COMMIT — it contains no real secrets.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lifeconnect
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ── Security / JWT ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api/distancematrix/json

# ── Email / SMTP ──────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=your@email.com
MAIL_USE_TLS=True

# ── Application ───────────────────────────────────────────────
APP_NAME=LifeConnect API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=False

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Scheduler ────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Kolkata
