# LifeConnect API Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://lifeconnect:password@localhost:5432/lifeconnect

# Connection pool settings (adjust based on your server capacity)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# =============================================================================
# SECURITY
# =============================================================================
# Secret key for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# EXTERNAL APIS
# =============================================================================
# Google Maps API for distance calculation
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api/distancematrix/json

# =============================================================================
# EMAIL
# =============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=yrclifeconnect@gmail.com
MAIL_USE_TLS=true

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=LifeConnect API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# CORS - Allowed origins (comma-separated for multiple)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Scheduler timezone
SCHEDULER_TIMEZONE=Asia/Kolkata
