# ============================================================
# LifeConnect API — Environment Variables Example
# Copy to .env and replace every CHANGE_ME value with a real one.
# This file is SAFE TO COMMIT — it contains no real secrets.
#
# The app REFUSES TO START while SECRET_KEY is still a placeholder or shorter than 32
# characters (in every environment), so a straight `cp .env.example .env` fails loudly
# instead of running with a guessable signing key. The test suite sets its own key and
# never reads your .env.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Running the backend on your machine against the compose database (docker-compose.dev.yml publishes it on
# 127.0.0.1:5432): use the same user, password and database name as the POSTGRES_* values below.
# In Docker, compose overrides this with a URL it builds from POSTGRES_*.
DATABASE_URL=postgresql+asyncpg://lifeconnect:CHANGE_ME_long_random_database_password@localhost:5432/lifeconnect
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ── Docker Compose only (docker-compose.yml reads these) ─────
# POSTGRES_PASSWORD has NO default: `docker compose up` refuses to start without it.
# Use a long random value; compose builds DATABASE_URL for the containers from it.
POSTGRES_USER=lifeconnect
POSTGRES_PASSWORD=CHANGE_ME_long_random_database_password
POSTGRES_DB=lifeconnect
# The ONLY address whose X-Forwarded-For the API believes: the nginx (frontend) container, pinned in
# docker-compose.yml. Never "*": that lets any client choose the IP its rate limit is counted against.
# Change it only together with the subnet / frontend address in docker-compose.yml.
# FORWARDED_ALLOW_IPS=172.28.0.10

# ── Security / JWT ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api/distancematrix/json

# ── reCAPTCHA ─────────────────────────────────────────────────
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# When true, login AND the public blood-request form require a valid reCAPTCHA token
# (the frontend sends it as recaptcha_token). APP_ENV=production refuses to start unless this is true.
RECAPTCHA_ENFORCED=false

# ── Email / SMTP ──────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=your@email.com
MAIL_USE_TLS=True

# ── Application ───────────────────────────────────────────────
APP_NAME=LifeConnect API
APP_VERSION=1.0.0
# production additionally requires RECAPTCHA_SECRET_KEY and RECAPTCHA_ENFORCED=true, and turns the
# interactive API docs (/docs, /redoc, /openapi.json) off unless ENABLE_DOCS=true.
APP_ENV=development
DEBUG=False
# Serve /docs, /redoc and /openapi.json. Unset: on in development, off in production.
# ENABLE_DOCS=true

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Production overlay settings. See docs/setup.md for certificate installation.
# LIFECONNECT_DOMAIN=
# LIFECONNECT_TLS_DIR=
# VITE_RECAPTCHA_SITE_KEY=
# PRODUCTION_ALLOWED_ORIGINS=[]

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
# Local single-process development only. Production Compose requires REDIS_PASSWORD.
# Supply a random URL-safe password through the deployment secret environment.
# REDIS_PASSWORD=
RATE_LIMIT_STORAGE_URI=memory://

# Per-IP limits on login and password-reset endpoints
AUTH_RATE_LIMIT=5/minute
PASSWORD_RESET_RATE_LIMIT=3/minute

# The public blood-request form emails the admins, so it has its own stricter per-IP limit
# (join several with ';'). One notification email (BCC) goes to at most this many active admins.
BLOOD_REQUEST_RATE_LIMIT=5/minute;30/hour
ADMIN_NOTIFY_MAX_RECIPIENTS=20
NOTIFY_INCLUDE_CONTACT=True
CERT_RETENTION_DAYS=30

# ── One-time codes ────────────────────────────────────────────
# The attempt budget belongs to the window: asking for a new code does not reset it, so after
# OTP_MAX_ATTEMPTS wrong guesses a user waits for the window (OTP_TTL_SECONDS) to end.
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# ── Donor eligibility ─────────────────────────────────────────
# Days a donor stays unavailable after their last donation (cooldown deferral period)
DONATION_COOLDOWN_DAYS=90

# ── Scheduler ────────────────────────────────────────────────
# Run jobs in exactly ONE dedicated process (`python -m app.scheduler_worker`); keep false on web workers
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata
# Start the in-process scheduler at startup when SCHEDULER_ENABLED=true (set false to run the
# dedicated `python -m app.scheduler_worker` process instead).
RUN_SCHEDULER=true

# Optional path to a .ttf/.otf font used on donation certificates. Unset uses DejaVuSans.
# CERT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

ACCOUNT_AUTH_RATE_LIMIT=10/10 minutes
ACCOUNT_CODE_SEND_RATE_LIMIT=3/10 minutes
