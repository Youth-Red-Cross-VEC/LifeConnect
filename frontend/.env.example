# ============================================================
# LifeConnect Frontend — Environment Variables Example
# Copy to .env in the frontend directory if custom configuration is needed.
# ============================================================

# Base URL for the FastAPI backend API service (defaults to http://localhost:8000 in dev)
VITE_API_URL=http://localhost:8000

# Google reCAPTCHA v2 Site Key
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
