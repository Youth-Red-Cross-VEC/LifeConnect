# Packages the API image installs (see Dockerfile). This is the INTENT; requirements-runtime.lock is the
# resolved, hash-pinned result that the image actually installs and that CI audits.
#
# To change a dependency: edit this file, then regenerate the lock with the same uv version the Dockerfile
# uses (the uv image has no Python, so run it inside the Python image the API targets):
#
#   docker run --rm -v "$PWD:/work" -w /work python:3.11-alpine sh -c \
#     "pip install -q uv==0.12.23 && uv pip compile requirements-runtime.in --universal \
#      --python-version 3.11 --generate-hashes -o requirements-runtime.lock"
#
# and commit both files. Test/dev tools (pytest, black, ...) are in requirements.txt and are NOT in the image.

fastapi
uvicorn[standard]
pydantic
pydantic-settings
email-validator
sqlalchemy[asyncio]
asyncpg
alembic
python-jose[cryptography]
passlib[bcrypt]
bcrypt<4.0.0
python-multipart
apscheduler
httpx
aiosmtplib
structlog
slowapi
python-dotenv
pillow
